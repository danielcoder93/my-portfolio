{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2020",
    "outDir": ".test-build",
    "noEmit": false,
    "incremental": false,
    "allowJs": false,
    "isolatedModules": false
  },
  "include": [
    "tests/**/*.ts",
    "lib/leads.ts",
    "lib/lead-email.ts",
    "lib/lead-handler.ts",
    "scripts/check-email.ts"
  ],
  "exclude": [
    "node_modules",
    ".test-build"
  ]
}
