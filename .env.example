# Use credentials from a transactional SMTP provider that supports SMTP passwords.
# Never use a personal Outlook/Hotmail sign-in password. All values stay server-side.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Verified sender at that provider and the inbox Daniel checks (one address each).
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
